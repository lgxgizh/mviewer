---
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
# Force LF line endings everywhere so local (Windows) and CI (Linux) clang-format
# agree. Without this, CRLF files pass locally but fail `clang-format --dry-run`
# on the Linux CI runner, breaking the format gate.
UseCRLF: false
AccessModifierOffset: -2
AllowShortFunctionsOnASingleLine: None
BreakBeforeBraces: Allman
PointerAlignment: Right
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
