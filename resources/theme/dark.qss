/* macOS-like theme template. Theme::buildStyleSheet substitutes token placeholders.
   Borders are reserved for inputs. Chrome separates with the separator token. */

QMainWindow {
    background: {{bg0}};
    color: {{textPrimary}};
    font-family: {{fontFamily}};
}

QDialog {
    background: {{bg1}};
    color: {{textPrimary}};
    font-family: {{fontFamily}};
}

QLabel {
    background: transparent;
}

QLabel[role="caption"] {
    color: {{textSecondary}};
    font-size: {{fontCaptionPx}}px;
}

QLabel[role="title"] {
    color: {{textPrimary}};
    font-size: {{fontTitlePx}}px;
    font-weight: 600;
}

QLabel[role="largeTitle"] {
    color: {{textPrimary}};
    font-size: {{fontLargeTitlePx}}px;
    font-weight: 600;
}

QLabel[role="sectionHeader"],
QLabel[sectionHeader="true"] {
    color: {{textSecondary}};
    background: transparent;
    font-size: {{fontCaptionPx}}px;
    font-weight: 600;
    padding-left: 12px;
}

QLabel#directoryLoadingLabel {
    color: {{textSecondary}};
    font-size: {{fontCaptionPx}}px;
    font-style: italic;
    padding: {{space4}}px;
}

QToolBar {
    background: {{bg1}};
    border: none;
    spacing: {{space4}}px;
    padding: {{space4}}px {{space8}}px;
}

QToolBar#browserToolBar {
    background: {{bg1}};
    border: none;
    border-bottom: 1px solid {{separator}};
    spacing: {{space4}}px;
    padding: 0px {{space8}}px;
    min-height: 40px;
    max-height: 44px;
}

QToolBar#browserToolBar QToolButton {
    padding: 2px;
    margin: 0px;
    border: none;
}

QToolBar#browserToolBar QToolButton[pill="true"][primary="true"] {
    border-radius: {{radiusSearch}}px;
    padding: 2px {{space12}}px;
    background: {{accent}};
    color: {{onAccent}};
    border: 1px solid {{accent}};
}

QToolBar#browserToolBar QToolButton[pill="true"][primary="true"]:hover {
    background: {{accentHover}};
    border-color: {{accentHover}};
}

QToolBar#browserToolBar QToolButton[pill="true"][primary="true"]:pressed {
    background: {{accentPressed}};
    border-color: {{accentPressed}};
}

QToolBar#browserToolBar QToolButton[pill="true"][primary="true"]:disabled {
    background: {{bg3}};
    color: {{textDisabled}};
    border-color: {{border}};
}

QToolBar::separator {
    background: {{separator}};
    width: 1px;
    margin: {{space4}}px {{space4}}px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: {{radiusControl}}px;
    padding: {{space4}}px;
    min-height: 20px;
    min-width: 20px;
    color: {{textPrimary}};
}

QToolButton:hover {
    background: {{hover}};
}

QToolButton:pressed {
    background: {{bg3}};
}

QToolButton:checked {
    background: {{accentTint}};
    color: {{accent}};
}

QToolButton:disabled {
    color: {{textDisabled}};
}

QToolButton:checked:hover {
    background: {{selection}};
}

QToolButton[pill="true"] {
    border-radius: {{radiusSearch}}px;
    padding: 2px {{space12}}px;
    background: {{bg2}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
}

QToolButton[pill="true"][primary="true"] {
    background: {{accent}};
    color: {{onAccent}};
    border: 1px solid {{accent}};
}

QToolButton[pill="true"][primary="true"]:hover {
    background: {{accentHover}};
    border-color: {{accentHover}};
}

QToolButton[pill="true"][primary="true"]:pressed {
    background: {{accentPressed}};
    border-color: {{accentPressed}};
}

QToolButton[pill="true"][primary="true"]:disabled {
    background: {{bg3}};
    color: {{textDisabled}};
    border-color: {{border}};
}

QPushButton {
    background: {{bg2}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    padding: {{space4}}px {{space12}}px;
    min-height: 20px;
}

QPushButton:hover {
    background: {{bg3}};
}

QPushButton:pressed {
    background: {{bg1}};
}

QPushButton:disabled {
    background: {{bg1}};
    color: {{textDisabled}};
    border-color: {{border}};
}

QPushButton:focus {
    border-color: {{accent}};
}

QPushButton:checked {
    background: {{accentTint}};
    color: {{textPrimary}};
    border-color: {{accent}};
}

QPushButton[flat="true"] {
    background: transparent;
    border: 1px solid transparent;
    color: {{textPrimary}};
}

QPushButton[flat="true"]:hover {
    background: {{hover}};
}

QPushButton[flat="true"]:pressed {
    background: {{bg3}};
}

QPushButton[flat="true"]:disabled {
    color: {{textDisabled}};
    background: transparent;
}

QPushButton[segmented="true"] {
    border-radius: 0px;
    border: 1px solid {{border}};
    background: {{bg2}};
    padding: {{space4}}px {{space12}}px;
}

QPushButton[segmented="true"]:checked {
    background: {{bg0}};
    color: {{textPrimary}};
    border-color: {{border}};
}

QPushButton[pill="true"] {
    border-radius: {{radiusSearch}}px;
    padding-left: {{space16}}px;
    padding-right: {{space16}}px;
}

/* Dialog accept buttons carry primary=true (Theme's dialog polisher). */
QPushButton:default {
    border: 1px solid {{accent}};
}

QPushButton[primary="true"] {
    background: {{accent}};
    color: {{onAccent}};
    border: 1px solid {{accent}};
}

QPushButton[primary="true"]:hover {
    background: {{accentHover}};
    border-color: {{accentHover}};
}

QPushButton[primary="true"]:pressed {
    background: {{accentPressed}};
    border-color: {{accentPressed}};
}

QPushButton[primary="true"]:disabled {
    background: {{bg3}};
    color: {{textDisabled}};
    border-color: {{border}};
}

QWidget[segmented="true"] {
    background: {{bg1}};
    border-radius: {{radiusControl}}px;
}

QWidget[segmented="true"] QPushButton {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QWidget[segmented="true"] QPushButton:checked {
    background: {{bg2}};
    border-radius: 6px;
    color: {{textPrimary}};
}

QWidget#viewModeSegment QPushButton {
    padding: 1px 4px;
    min-width: 0px;
    min-height: 0px;
    max-height: 24px;
    border: none;
    background: transparent;
}

QWidget#viewModeSegment QPushButton:hover {
    background: {{hover}};
}

QWidget#viewModeSegment QPushButton:checked {
    background: {{bg0}};
    border-radius: 6px;
    color: {{textPrimary}};
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QMessageBox {
    background: {{bg1}};
}

QMessageBox QLabel#qt_msgbox_label {
    color: {{textPrimary}};
    min-width: 240px;
}

QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background: {{bg0}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    padding: {{space4}}px;
    selection-background-color: {{selection}};
    selection-color: {{textPrimary}};
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: {{accent}};
    background: {{accentTint}};
}

QCheckBox,
QRadioButton {
    spacing: {{space8}}px;
    color: {{textPrimary}};
    background: transparent;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: {{textDisabled}};
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{border}};
    border-radius: {{radiusChip}}px;
    background: {{bg2}};
}

QCheckBox::indicator:hover {
    border-color: {{accent}};
}

QCheckBox::indicator:checked {
    background: {{accent}};
    border-color: {{accent}};
    image: url(:/theme/check.png);
}

QCheckBox::indicator:pressed,
QRadioButton::indicator:pressed {
    border-color: {{accentPressed}};
}

QCheckBox::indicator:disabled {
    background: {{bg1}};
    border-color: {{border}};
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{border}};
    border-radius: 8px;
    background: {{bg2}};
}

QRadioButton::indicator:hover {
    border-color: {{accent}};
}

QRadioButton::indicator:checked {
    background: {{accent}};
    border-color: {{accent}};
    image: url(:/theme/dot.png);
}

QRadioButton::indicator:disabled {
    background: {{bg1}};
    border-color: {{border}};
}

/* Compare mode switches: indicator hidden, the box itself is the segment. */
QCheckBox[segmented="true"] {
    spacing: 0px;
    padding: 2px 6px;
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    background: {{bg2}};
    color: {{textPrimary}};
}

QCheckBox[segmented="true"]::indicator {
    width: 0px;
    height: 0px;
    border: none;
}

QCheckBox[segmented="true"]:hover {
    background: {{bg3}};
}

QCheckBox[segmented="true"]:checked {
    background: {{accentTint}};
    border-color: {{accent}};
    color: {{textPrimary}};
}

QCheckBox[segmented="true"]:checked:hover {
    background: {{accentTint}};
}

QCheckBox[segmented="true"]:disabled {
    color: {{textDisabled}};
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background: {{bg2}};
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    padding: 3px {{space8}}px;
    min-height: 20px;
    color: {{textPrimary}};
    selection-background-color: {{selection}};
    selection-color: {{textPrimary}};
}

QLineEdit[search="true"] {
    border-radius: {{radiusSearch}}px;
    padding-left: {{space12}}px;
    padding-right: {{space12}}px;
}

QComboBox[pill="true"] {
    border-radius: {{radiusSearch}}px;
    padding-left: {{space12}}px;
    padding-right: {{space8}}px;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: {{textDisabled}};
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid {{accent}};
    background: {{accentTint}};
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: {{textDisabled}};
    background: {{bg1}};
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/theme/chevron-down.png);
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/theme/chevron-up.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/theme/chevron-down.png);
    width: 10px;
    height: 10px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 16px;
    background: transparent;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: {{hover}};
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background: {{bg3}};
}

QComboBox QAbstractItemView {
    background: {{bg1}};
    color: {{textPrimary}};
    border: 1px solid {{separator}};
    border-radius: {{radiusPanel}}px;
    selection-background-color: {{accent}};
    selection-color: {{onAccent}};
    outline: none;
    padding: {{space4}}px;
}

QComboBox QAbstractItemView::item {
    min-height: 20px;
    padding: 6px 12px;
    border-radius: {{radiusChip}}px;
}

QComboBox QAbstractItemView::item:hover {
    background: {{hover}};
}

QComboBox QAbstractItemView::item:selected {
    background: {{accent}};
    color: {{onAccent}};
}

QSlider::groove:horizontal {
    height: 4px;
    background: {{bg3}};
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: {{accent}};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: {{textPrimary}};
    border: none;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: {{onAccent}};
}

QSlider::groove:vertical {
    width: 4px;
    background: {{bg3}};
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: {{accent}};
    border-radius: 2px;
}

QSlider::handle:vertical {
    height: 14px;
    width: 14px;
    margin: 0 -5px;
    background: {{textPrimary}};
    border: none;
    border-radius: 7px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: {{scrollHandle}};
    min-height: 24px;
    border-radius: 3px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: {{scrollHandleHover}};
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: {{scrollHandleHover}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: {{scrollHandle}};
    min-width: 24px;
    border-radius: 3px;
    margin: 1px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::corner {
    background: transparent;
}

QTabWidget::pane {
    border: none;
    background: {{bg0}};
}

QTabBar {
    background: {{bg1}};
    border-radius: {{radiusControl}}px;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: {{textSecondary}};
    border: none;
    border-radius: 6px;
    padding: {{space4}}px {{space12}}px;
    margin: 2px;
    min-height: 20px;
}

QTabBar::tab:selected {
    background: {{bg2}};
    color: {{textPrimary}};
}

QTabBar::tab:hover:!selected {
    background: {{hover}};
    color: {{textPrimary}};
}

QTabBar::tab:pressed {
    background: {{bg3}};
}

QHeaderView::section {
    background: {{bg1}};
    color: {{textSecondary}};
    padding: {{space4}}px {{space8}}px;
    border: none;
    border-bottom: 1px solid {{separator}};
    font-size: {{fontCaptionPx}}px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background: {{bg2}};
    color: {{textPrimary}};
}

QTreeView,
QTableView,
QListView,
QTreeWidget,
QTableWidget,
QListWidget {
    background-color: {{bg0}};
    alternate-background-color: {{bg1}};
    color: {{textPrimary}};
    border: none;
    outline: none;
    selection-background-color: {{accent}};
    selection-color: {{onAccent}};
}

QTableView {
    gridline-color: {{separator}};
}

QAbstractScrollArea {
    border: none;
}

QScrollArea {
    border: none;
    background: transparent;
}

QFrame {
    border: none;
}

/* Restate input edges. The blanket scroll-area and frame rules above match
   these classes too, and an equal-specificity rule later in the file wins. */
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: {{accent}};
}

/* Branch indicators stay with the style (chevron assets are for combo/spin). */
QTreeView {
    show-decoration-selected: 0;
}

QTreeView::item,
QTableView::item,
QListWidget::item {
    padding: 2px {{space8}}px;
    min-height: 22px;
    border-radius: 6px;
}

QListView::item {
    border-radius: 6px;
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover,
QTreeWidget::item:hover,
QTableWidget::item:hover,
QListWidget::item:hover {
    background: {{hover}};
}

QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected,
QListWidget::item:selected {
    background: {{accent}};
    color: {{onAccent}};
    border-radius: 6px;
}

QTreeView:!focus::item:selected,
QTableView:!focus::item:selected,
QListView:!focus::item:selected,
QTreeWidget:!focus::item:selected,
QTableWidget:!focus::item:selected,
QListWidget:!focus::item:selected,
QTreeView::item:selected:!active,
QTableView::item:selected:!active,
QListView::item:selected:!active,
QTreeWidget::item:selected:!active,
QTableWidget::item:selected:!active,
QListWidget::item:selected:!active {
    background: {{bg3}};
    color: {{textPrimary}};
}

QTreeView:focus::item:selected:hover,
QTableView:focus::item:selected:hover,
QListView:focus::item:selected:hover,
QTreeWidget:focus::item:selected:hover,
QTableWidget:focus::item:selected:hover,
QListWidget:focus::item:selected:hover {
    background: {{accentHover}};
    color: {{onAccent}};
}

QMenuBar {
    background: {{bg1}};
    color: {{textPrimary}};
    border: none;
    border-bottom: 1px solid {{separator}};
}

QMenuBar::item {
    background: transparent;
    padding: {{space4}}px {{space8}}px;
    border-radius: {{radiusControl}}px;
}

QMenuBar::item:selected {
    background: {{hover}};
}

QMenuBar::item:pressed {
    background: {{bg3}};
}

QMenu {
    background: {{bg1}};
    color: {{textPrimary}};
    border: 1px solid {{separator}};
    border-radius: {{radiusPanel}}px;
    padding: {{space4}}px;
}

QMenu::item {
    padding: 6px 12px;
    border-radius: {{radiusChip}}px;
    background: transparent;
}

QMenu::item:selected {
    background: {{accent}};
    color: {{onAccent}};
}

QMenu::item:pressed {
    background: {{accentPressed}};
    color: {{onAccent}};
}

QMenu::item:disabled {
    color: {{textDisabled}};
}

QMenu::separator {
    height: 1px;
    background: {{separator}};
    margin: {{space4}}px {{space8}}px;
}

QToolTip {
    background: {{bg1}};
    color: {{textPrimary}};
    border: 1px solid {{separator}};
    border-radius: {{radiusTooltip}}px;
    padding: {{space4}}px {{space8}}px;
    font-family: {{fontFamily}};
    font-size: {{fontCaptionPx}}px;
}

QStatusBar {
    background: {{bg1}};
    color: {{textSecondary}};
    border: none;
    border-top: 1px solid {{separator}};
    font-size: {{fontCaptionPx}}px;
    min-height: 22px;
    max-height: 24px;
    padding: 0px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: {{textSecondary}};
    font-size: {{fontCaptionPx}}px;
    padding: 0px {{space8}}px;
}

QWidget#primaryBrowsePane,
QWidget#secondaryBrowsePane {
    background: {{bg0}};
    border: none;
    border-top: 2px solid transparent;
}

QWidget#primaryBrowsePane[activePane="true"],
QWidget#secondaryBrowsePane[activePane="true"] {
    border-top: 2px solid {{accent}};
}

QSplitter::handle {
    background: {{separator}};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QDockWidget {
    color: {{textPrimary}};
    border: none;
}

QDockWidget::title {
    background: {{sidebar}};
    color: {{textPrimary}};
    padding: {{space8}}px;
    border: none;
    border-bottom: 1px solid {{separator}};
    text-align: left;
}

QGroupBox {
    border: none;
    border-top: 1px solid {{separator}};
    border-radius: 0px;
    margin-top: {{space12}}px;
    padding: {{space12}}px;
    padding-top: {{space16}}px;
    color: {{textPrimary}};
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 {{space4}}px;
    left: {{space8}}px;
    color: {{textSecondary}};
}

QProgressBar {
    border: none;
    border-radius: {{radiusControl}}px;
    background: {{bg3}};
    color: {{textPrimary}};
    text-align: center;
    min-height: 8px;
}

QProgressBar::chunk {
    background: {{accent}};
    border-radius: 4px;
}

/* Sidebar (folder tree + favorites) vs content (thumbnail grid). */
QSplitter#navigationPanel,
QWidget#foldersSection,
QWidget#previewSection {
    background: {{sidebar}};
    border: none;
}

QSplitter#navigationPanel QTreeView,
QSplitter#navigationPanel QListWidget {
    background-color: {{sidebar}};
    alternate-background-color: {{sidebar}};
    border: none;
}

QSplitter#navigationPanel QTreeView::item {
    padding: 2px 0px;
    border-radius: 6px;
}

/* Finder-style sidebar captions: small grey, aligned with the row text. */
QSplitter#navigationPanel QLabel[sectionHeader="true"] {
    padding-left: {{space4}}px;
}

QSplitter#navigationPanel QTreeView::item:selected {
    background: {{accent}};
    color: {{onAccent}};
    border-radius: 6px;
}

QSplitter#navigationPanel QTreeView:!focus::item:selected,
QSplitter#navigationPanel QTreeView::item:selected:!active {
    background: {{bg3}};
    color: {{textPrimary}};
}

QSplitter#navigationPanel::handle {
    background: {{sidebar}};
}

/* Preview info card at the bottom of the sidebar. */
QFrame#previewCard {
    background: {{bg0}};
    border: 1px solid {{separator}};
    border-radius: {{radiusPanel}}px;
}

QSplitter#navigationPanel QListWidget::item {
    padding: 3px {{space8}}px;
    color: {{textPrimary}};
    border-radius: 6px;
}

QSplitter#navigationPanel QListWidget::item:hover {
    background: {{hover}};
}

QListView#thumbnailPanel,
QListView#secondaryThumbnailPanel {
    background-color: {{bg0}};
    border: none;
}

QWidget#breadcrumbBar QToolButton {
    border: 1px solid transparent;
    border-radius: {{radiusChip}}px;
    padding: 1px {{space4}}px;
    color: {{textPrimary}};
    font-size: {{fontCaptionPx}}px;
    background: transparent;
}

QWidget#breadcrumbBar QToolButton:hover {
    background: {{hover}};
    color: {{accent}};
    border-color: transparent;
}

QWidget#breadcrumbBar QLabel {
    color: {{textSecondary}};
    background: transparent;
    font-size: {{fontCaptionPx}}px;
}

QWidget#compareStatusStrip {
    background: {{bg0}};
    border: none;
    border-top: 1px solid {{separator}};
}

QLabel#diffMetricsLabel {
    color: {{accent}};
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: {{fontCaptionPx}}px;
    font-weight: 600;
    padding: 2px {{space8}}px;
    background: {{bg0}};
    border: 1px solid {{border}};
    border-radius: {{radiusChip}}px;
}

QLabel#compareStatusLabel {
    color: {{textSecondary}};
    background: transparent;
}

QCheckBox#autoAlignBeforeDiffToggle {
    color: {{textPrimary}};
    background: transparent;
}

MetadataPanel {
    background: {{bg0}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    border-radius: {{radiusPanel}}px;
}

QLabel[readout="text"],
QLabel[readout="mono"] {
    background: {{bg0}};
    color: {{textPrimary}};
    padding: {{space8}}px;
}

QLabel[readout="mono"] {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: {{fontCaptionPx}}px;
}

QLabel[plot="true"] {
    background: #121214;
}

QFrame#typeHiddenHint {
    background: {{bg1}};
    border: 1px solid {{separator}};
    border-radius: {{radiusPanel}}px;
}

QLabel#typeHiddenHintLabel {
    color: {{textPrimary}};
}
