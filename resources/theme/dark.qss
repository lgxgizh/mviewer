/* Flat theme template. Theme::buildStyleSheet substitutes the token placeholders. */

QMainWindow {
    background: {{bg0}};
    color: {{textPrimary}};
}

QDialog {
    background: {{bg1}};
    color: {{textPrimary}};
}

QLabel {
    background: transparent;
}

QToolBar {
    background: {{bg1}};
    border: none;
    spacing: {{space4}}px;
    padding: {{space4}}px {{space8}}px;
}

QToolBar::separator {
    background: {{border}};
    width: 1px;
    margin: {{space4}}px {{space4}}px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: {{radiusControl}}px;
    padding: {{space4}}px;
    color: {{textPrimary}};
}

QToolButton:hover {
    background: {{bg2}};
}

QToolButton:pressed {
    background: {{bg3}};
}

QToolButton:checked {
    background: {{accentTint}};
    color: {{accent}};
}

QToolButton:disabled {
    color: {{textDisabled}};
}

QPushButton {
    background: {{bg2}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    padding: {{space4}}px {{space12}}px;
    min-height: 20px;
}

QPushButton:hover {
    background: {{bg3}};
}

QPushButton:pressed {
    background: {{bg3}};
}

QPushButton:disabled {
    background: {{bg1}};
    color: {{textDisabled}};
    border-color: {{border}};
}

QPushButton:default,
QPushButton[primary="true"] {
    background: {{accent}};
    color: {{onAccent}};
    border: 1px solid {{accent}};
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background: {{accentHover}};
    border-color: {{accentHover}};
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background: {{accentPressed}};
    border-color: {{accentPressed}};
}

QPushButton:default:disabled,
QPushButton[primary="true"]:disabled {
    background: {{bg3}};
    color: {{textDisabled}};
    border-color: {{border}};
}

QCheckBox,
QRadioButton {
    spacing: {{space8}}px;
    color: {{textPrimary}};
    background: transparent;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: {{textDisabled}};
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{border}};
    border-radius: 3px;
    background: {{bg0}};
}

QCheckBox::indicator:hover {
    border-color: {{accent}};
}

QCheckBox::indicator:checked {
    background: {{accent}};
    border-color: {{accent}};
    image: url(:/theme/check.png);
}

QCheckBox::indicator:disabled {
    background: {{bg2}};
    border-color: {{border}};
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{border}};
    border-radius: 7px;
    background: {{bg0}};
}

QRadioButton::indicator:hover {
    border-color: {{accent}};
}

QRadioButton::indicator:checked {
    background: {{accent}};
    border-color: {{accent}};
    image: url(:/theme/dot.png);
}

QRadioButton::indicator:disabled {
    background: {{bg2}};
    border-color: {{border}};
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background: {{bg0}};
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    padding: 3px {{space8}}px;
    color: {{textPrimary}};
    selection-background-color: {{selection}};
    selection-color: {{textPrimary}};
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid {{accent}};
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: {{textDisabled}};
    background: {{bg1}};
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: {{bg1}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    selection-background-color: {{selection}};
    selection-color: {{textPrimary}};
    outline: none;
    padding: {{space4}}px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: {{bg3}};
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: {{accent}};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: {{textPrimary}};
    border: none;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: {{onAccent}};
}

QSlider::groove:vertical {
    width: 4px;
    background: {{bg3}};
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: {{accent}};
    border-radius: 2px;
}

QSlider::handle:vertical {
    height: 14px;
    width: 14px;
    margin: 0 -5px;
    background: {{textPrimary}};
    border: none;
    border-radius: 7px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: {{border}};
    min-height: 24px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: {{textSecondary}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: {{border}};
    min-width: 24px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: {{textSecondary}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::corner {
    background: transparent;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid {{border}};
    background: {{bg1}};
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: {{textSecondary}};
    border: none;
    border-bottom: 2px solid transparent;
    padding: {{space8}}px {{space16}}px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    color: {{textPrimary}};
    border-bottom: 2px solid {{accent}};
}

QTabBar::tab:hover:!selected {
    color: {{textPrimary}};
    background: {{bg2}};
}

QHeaderView::section {
    background: {{bg1}};
    color: {{textSecondary}};
    padding: {{space4}}px {{space8}}px;
    border: none;
    border-right: 1px solid {{border}};
    border-bottom: 1px solid {{border}};
}

QTreeView,
QTableView,
QListView,
QTreeWidget,
QTableWidget,
QListWidget {
    background-color: {{bg0}};
    alternate-background-color: {{bg1}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    outline: none;
    selection-background-color: {{selection}};
    selection-color: {{textPrimary}};
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover,
QTreeWidget::item:hover,
QTableWidget::item:hover,
QListWidget::item:hover {
    background: {{bg2}};
}

QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected,
QListWidget::item:selected {
    background: {{selection}};
    color: {{textPrimary}};
}

QMenuBar {
    background: {{bg1}};
    color: {{textPrimary}};
    border: none;
    border-bottom: 1px solid {{border}};
}

QMenuBar::item {
    background: transparent;
    padding: {{space4}}px {{space8}}px;
    border-radius: {{radiusControl}}px;
}

QMenuBar::item:selected {
    background: {{bg2}};
}

QMenuBar::item:pressed {
    background: {{bg3}};
}

QMenu {
    background: {{bg1}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    border-radius: {{radiusPanel}}px;
    padding: {{space4}}px;
}

QMenu::item {
    padding: {{space8}}px 24px {{space8}}px {{space12}}px;
    border-radius: 4px;
    background: transparent;
}

QMenu::item:selected {
    background: {{selection}};
    color: {{textPrimary}};
}

QMenu::item:disabled {
    color: {{textDisabled}};
}

QMenu::separator {
    height: 1px;
    background: {{border}};
    margin: {{space4}}px {{space8}}px;
}

QToolTip {
    background: {{bg2}};
    color: {{textPrimary}};
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    padding: {{space4}}px {{space8}}px;
    font-family: {{fontFamily}};
    font-size: {{fontPt}}pt;
}

QStatusBar {
    background: {{bg1}};
    color: {{textSecondary}};
    border-top: 1px solid {{border}};
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: {{textSecondary}};
    padding: 1px {{space8}}px;
}

QSplitter::handle {
    background: {{border}};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QDockWidget {
    color: {{textPrimary}};
}

QDockWidget::title {
    background: {{bg1}};
    color: {{textPrimary}};
    padding: {{space8}}px;
    border-bottom: 1px solid {{border}};
    text-align: left;
}

QGroupBox {
    border: 1px solid {{border}};
    border-radius: {{radiusPanel}}px;
    margin-top: {{space12}}px;
    padding: {{space8}}px;
    padding-top: {{space12}}px;
    color: {{textPrimary}};
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 {{space4}}px;
    left: {{space8}}px;
    color: {{textSecondary}};
}

QProgressBar {
    border: 1px solid {{border}};
    border-radius: {{radiusControl}}px;
    background: {{bg0}};
    color: {{textPrimary}};
    text-align: center;
    min-height: 8px;
}

QProgressBar::chunk {
    background: {{accent}};
    border-radius: 4px;
}
